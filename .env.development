# Development Environment Configuration
# Steel Trading Application - Development Environment

VITE_APP_NAME="Steel Trading App (DEV)"
VITE_APP_ENV=development
VITE_APP_DEBUG=true

# API Configuration - Local Development
# VITE_API_BASE_URL=http://localhost/steelapp/backend/api
VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_TIMEOUT=30000

# Application Settings
VITE_APP_VERSION=1.0.0-dev
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PWA=false

# Development Settings
VITE_DEV_TOOLS=true
VITE_MOCK_API=false
VITE_HOT_RELOAD=true

# Security Settings (Relaxed for development)
VITE_ENABLE_SSL=false
VITE_SECURE_COOKIES=false
VITE_STRICT_MODE=false

# Development Features
VITE_SHOW_DEBUG_INFO=true
VITE_ENABLE_CONSOLE_LOGS=true
VITE_AUTO_REFRESH=true

# Development Database (if different)
VITE_DEV_MODE=true
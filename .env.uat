# UAT Environment Configuration
# Steel Trading Application - User Acceptance Testing Environment

VITE_APP_NAME="Steel Trading App (UAT)"
VITE_APP_ENV=uat
VITE_APP_DEBUG=false

# API Configuration - UAT Server
VITE_API_BASE_URL=https://uat.steeltrading.com/backend/api
VITE_API_TIMEOUT=30000

# Application Settings
VITE_APP_VERSION=1.0.0-uat
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PWA=true

# UAT Settings
VITE_DEV_TOOLS=false
VITE_MOCK_API=false
VITE_HOT_RELOAD=false

# Security Settings (Production-like but with some debugging)
VITE_ENABLE_SSL=true
VITE_SECURE_COOKIES=true
VITE_STRICT_MODE=true

# UAT Features
VITE_SHOW_DEBUG_INFO=false
VITE_ENABLE_CONSOLE_LOGS=false
VITE_AUTO_REFRESH=false

# UAT Specific
VITE_UAT_MODE=true
VITE_FEEDBACK_ENABLED=true
VITE_TEST_USER_ACCESS=true
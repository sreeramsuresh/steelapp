# Steel Trading Application Backend - Environment Configuration Template
# Copy this file to .env and update with your actual values

# Database Configuration
DB_HOST=localhost
DB_NAME=steel_app
DB_USER=steel_user
DB_PASS=your_secure_password
DB_CHARSET=utf8mb4
DB_PORT=3306

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_NAME="Steel Trading API"
APP_VERSION=1.0.0

# Security Settings
JWT_SECRET=your_very_secure_jwt_secret_key_here
JWT_EXPIRY=3600
ENCRYPTION_KEY=your_encryption_key_here

# CORS Configuration
CORS_ORIGINS=http://localhost:3030,http://localhost:5173,https://yourdomain.com
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
ENABLE_QUERY_LOG=false

# API Settings
API_VERSION=v1
API_PREFIX=/api
MAX_UPLOAD_SIZE=10485760

# Email Configuration (for notifications)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# Cache Settings
CACHE_DRIVER=file
CACHE_TTL=3600

# Security Headers
ENABLE_HSTS=true
ENABLE_CSP=true
ENABLE_XSS_PROTECTION=true
# Steel Trading Application Backend - Production Environment
# IMPORTANT: Copy this to .env and update with your actual production values

# Database Configuration
DB_HOST=localhost
DB_NAME=steel_trading_prod
DB_USER=prod_user
DB_PASS=CHANGE_THIS_SECURE_PASSWORD_IN_PRODUCTION
DB_CHARSET=utf8mb4
DB_PORT=3306

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_NAME="Steel Trading API"
APP_VERSION=1.0.0

# Security Settings - MUST BE CHANGED FOR PRODUCTION
JWT_SECRET=CHANGE_THIS_SUPER_SECURE_JWT_SECRET_FOR_PRODUCTION
JWT_EXPIRY=3600
ENCRYPTION_KEY=CHANGE_THIS_ENCRYPTION_KEY_FOR_PRODUCTION

# CORS Configuration - Update with your actual domain
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With

# Rate Limiting (Strict for production)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Logging (Error level only for production)
LOG_LEVEL=error
LOG_FILE=logs/app.log
ENABLE_QUERY_LOG=false

# API Settings
API_VERSION=v1
API_PREFIX=/api
MAX_UPLOAD_SIZE=10485760

# Email Configuration - Update with your SMTP settings
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=YOUR_EMAIL_PASSWORD
SMTP_FROM=noreply@yourdomain.com

# Cache Settings
CACHE_DRIVER=file
CACHE_TTL=3600

# Security Headers (All enabled for production)
ENABLE_HSTS=true
ENABLE_CSP=true
ENABLE_XSS_PROTECTION=true

# Production Features
ENABLE_BACKUP=true
BACKUP_RETENTION_DAYS=30
ENABLE_MONITORING=true
ENABLE_ERROR_REPORTING=true

# Performance Settings
ENABLE_GZIP=true
ENABLE_CACHE_HEADERS=true
CACHE_STATIC_ASSETS=true
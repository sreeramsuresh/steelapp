RewriteEngine On

# Enable CORS for all requests
Header always set Access-Control-Allow-Origin "*"
Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"

# Handle preflight requests
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# API Routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Customers API
RewriteRule ^api/customers/?(.*)$ api/customers.php/$1 [QSA,L]

# Products API  
RewriteRule ^api/products/?(.*)$ api/products.php/$1 [QSA,L]

# Invoices API
RewriteRule ^api/invoices/?(.*)$ api/invoices.php/$1 [QSA,L]

# Default error for undefined routes
RewriteRule ^api/(.*)$ - [R=404,L]
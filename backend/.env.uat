# Steel Trading Application Backend - UAT Environment
# Copy this file to .env for UAT deployment

# Database Configuration
DB_HOST=localhost
DB_NAME=steel_trading_uat
DB_USER=uat_user
DB_PASS=uat_secure_password_change_this
DB_CHARSET=utf8mb4
DB_PORT=3306

# Application Settings
APP_ENV=uat
APP_DEBUG=false
APP_NAME="Steel Trading API (UAT)"
APP_VERSION=1.0.0-uat

# Security Settings
JWT_SECRET=uat_jwt_secret_key_must_be_changed
JWT_EXPIRY=3600
ENCRYPTION_KEY=uat_encryption_key_must_be_changed

# CORS Configuration (Restricted to UAT domain)
CORS_ORIGINS=https://uat.steeltrading.com,https://uat-admin.steeltrading.com
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With

# Rate Limiting (Moderate for testing)
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW=3600

# Logging (Info level for UAT)
LOG_LEVEL=info
LOG_FILE=logs/app.log
ENABLE_QUERY_LOG=false

# API Settings
API_VERSION=v1
API_PREFIX=/api
MAX_UPLOAD_SIZE=10485760

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=uat@steeltrading.com
SMTP_PASS=uat_email_password
SMTP_FROM=uat@steeltrading.com

# Cache Settings
CACHE_DRIVER=file
CACHE_TTL=3600

# Security Headers (Enabled for UAT)
ENABLE_HSTS=true
ENABLE_CSP=true
ENABLE_XSS_PROTECTION=true

# UAT Features
ENABLE_TEST_DATA=true
ENABLE_USER_FEEDBACK=true
ENABLE_PERFORMANCE_MONITORING=true
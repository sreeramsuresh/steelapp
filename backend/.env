# Steel Trading Application Backend - Development Environment
# Copy this file to .env.development for development setup

# Database Configuration
DB_HOST=localhost
DB_NAME=steel_app
DB_USER=steel_user
DB_PASS=secure_password
DB_CHARSET=utf8mb4
DB_PORT=3306

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_NAME="Steel Trading API (DEV)"
APP_VERSION=1.0.0-dev

# Security Settings
JWT_SECRET=dev_jwt_secret_key_change_in_production
JWT_EXPIRY=7200
ENCRYPTION_KEY=dev_encryption_key_change_in_production

# CORS Configuration (Permissive for development)
CORS_ORIGINS=http://localhost:5173,http://localhost:3030,http://localhost:8080,http://127.0.0.1:5173
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With,X-API-Key

# Rate Limiting (Relaxed for development)
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# Logging (Verbose for development)
LOG_LEVEL=debug
LOG_FILE=logs/app.log
ENABLE_QUERY_LOG=true

# API Settings
API_VERSION=v1
API_PREFIX=/api
MAX_UPLOAD_SIZE=10485760

# Email Configuration (for notifications)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=dev@steeltrading.com

# Cache Settings
CACHE_DRIVER=file
CACHE_TTL=1800

# Security Headers (Relaxed for development)
ENABLE_HSTS=false
ENABLE_CSP=false
ENABLE_XSS_PROTECTION=true

# Development Features
ENABLE_DEBUG_MODE=true
SHOW_SQL_QUERIES=true
ENABLE_PROFILING=true
# Production Environment Configuration
# Steel Trading Application - Production Environment

VITE_APP_NAME="Steel Trading App"
VITE_APP_ENV=production
VITE_APP_DEBUG=false

# API Configuration - Production Server
VITE_API_BASE_URL=/backend/api
VITE_API_TIMEOUT=10000

# Application Settings
VITE_APP_VERSION=1.0.0
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PWA=true

# Production Settings (Optimized for performance)
VITE_DEV_TOOLS=false
VITE_MOCK_API=false
VITE_HOT_RELOAD=false

# Security Settings (Maximum security for production)
VITE_ENABLE_SSL=true
VITE_SECURE_COOKIES=true
VITE_STRICT_MODE=true

# Production Features (Minimal debugging)
VITE_SHOW_DEBUG_INFO=false
VITE_ENABLE_CONSOLE_LOGS=false
VITE_AUTO_REFRESH=false

# Production Optimization
VITE_MINIFY=true
VITE_COMPRESS=true
VITE_CACHE_BUSTING=true

# Monitoring
VITE_ENABLE_ERROR_REPORTING=true
VITE_PERFORMANCE_MONITORING=true